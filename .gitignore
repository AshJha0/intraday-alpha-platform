# --- generated data (seeded; regenerate with `python -m iap.marketdata` /
# `python -m iap.features`; docs/BUILD_NOTES.md: "do not commit generated data")
data/raw/
data/normalized/
data/orderbooks/
data/features/
# data/reference/feature_registry.json is tracked (the feature_version source)

# --- pickled estimators (manifest.json / metrics.json per run ARE tracked)
research/models/*/model.pkl
*.parquet

# --- build trees (ANCHORED: a bare `build/`/`out/`/`target/` pattern would
# swallow any directory of that name anywhere, e.g. a future research/out/)
/cpp/build/
/rust/target/
/java/out/

# --- python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
python/build/
python/dist/

# --- editor / OS / logs
# NOTE: only the JVM's own stdout redirects; audit logs are *.jsonl under the
# platform state directory and are deliberately NOT ignored (a committed
# incident record must be possible).
/logs/
*.tmp
*.swp
.DS_Store
.idea/
.vscode/

# --- platform state (PLATFORM_CONVENTIONS.md §12.3): risk snapshots, session
# accounting and audit JSONL are runtime artefacts of a session, not sources.
/java/out/state/
/data/state/
