# Normalise text to LF in the repository and in working trees (the golden
# vectors and canonical-JSON byte-parity checks depend on exact bytes).
* text=auto eol=lf

# Golden vectors are compared byte for byte across four languages: never
# convert their line endings.
tests/golden/** -text

# Binary artefacts.
*.parquet binary
*.iap1 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.class binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary

# Windows batch wrapper started detached by cmd.exe: keep CRLF.
research/auction/rel08c/run_rel08c.cmd text eol=crlf
# Windows batch files of the B8 v2 run must stay CRLF on checkout.
research/execution/b8v2/*.cmd text eol=crlf
research/execution/rel05/*.cmd text eol=crlf
research/v118/rel04_verify/*.cmd text eol=crlf

# REL-04c: cmd.exe needs CRLF (a LF .cmd mis-parses labels / goto).
research/execution/rel04c/*.cmd text eol=crlf
research/v118/f3_accept/*.cmd text eol=crlf

# v2.0 stage 1 PR R0: the frozen confirmatory test specification is committed
# byte for byte (CRLF, sha256 900d9e73...); python/tests/spec/test_r0_frozen.py
# re-hashes it, so git must never normalise its line endings.
python/tests/spec/CONFIRMATORY_TEST_SPEC.md -text

# v2.0 stage 5: the frozen H1 economic specification (E0 revision 6) is committed
# byte for byte (CRLF, sha256 e1099e33...); python/tests/equivalence/test_e0_frozen.py
# re-hashes it, so git must never normalise its line endings.
research/v119/H1_ALPHA_IMPROVEMENT_SPEC.md -text
