  "implementation": {
    "label": "spread-netted forward mid log return over the variant horizon: sign(r) * max(|r| - (half-spread at t + half-spread at t+h) / mid, 0); a label whose horizon crosses the session close (the last row of the session) is incomplete (the labels_v2 session rule)",
    "alt_normalisation": "raw score divided by the name's trailing 30-minute realised volatility of 1-minute mid log returns, then demeaned and studentised",
    "beta": "beta_w5m_v1 of the xasset_v2 store: last finite value at or before t, at most 30 minutes old; a missing beta reads as 1 and is counted",
    "cov_warmup": "the book_multi7 warm-up of 20 five-minute returns kept as 100 minutes of the variant's rebalance clock: cov_init = max(2, cov_warmup_min / rebalance_min)",
    "net_series": "per decision k: the gross P&L over (t_k, t_k+1] minus the costs of the trade at t_k; the session-end flatten cost is added to the last decision; bps of the notional; mean over usable decisions",
    "conservative_costs": "the same trades re-charged at spread_mult x spread + fee_mult x fee + impact_mult x impact",
    "influential_names": "per-name net contribution = gross minus the name's traded-notional share of each rebalance's costs; the book is re-run without the C6_names_removed names of largest |contribution|",
    "universe": "vwap_deviation: every EQUITY / ETF name of the dataset; residual_reversion and etf_catch_up: the EQUITY names whose reference ETF (the map) is another instrument of the dataset",
    "ess": "n / max(Newey-West variance inflation with lag = block length (Bartlett weights), ess_inflation_floor)",
    "lower_bound": "the (alpha / K) quantile of the moving-block bootstrap means (one-sided); block length = block_minutes / rebalance_min rebalances"
  },
