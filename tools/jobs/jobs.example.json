{
  "_comment": "Template. Copy to data/real/jobs.json (git-ignored) and edit. Relative paths resolve against the registry file's directory. See docs/runbooks/RUNBOOK_job_watchdog.md. process_pattern 'chai[n]' is the bracket trick: the regex never matches a command line that merely contains the pattern text itself (e.g. a findstr/grep).",
  "watchdog_log": "watchdog.log",
  "state_file": "watchdog_state.json",
  "jobs": [
    {
      "name": "maker_real",
      "wrapper": "run_maker_real.cmd",
      "log": "maker_real.log",
      "process_pattern": "iap\\.research\\.maker_real",
      "done_regex": "^EXIT 0\\s*$",
      "restart_safe": false,
      "max_restarts": 0,
      "stall_minutes": 90
    },
    {
      "name": "r7_insample_chain",
      "wrapper": "run_r7_insample_chain.cmd",
      "log": "r7_insample_chain.log",
      "process_pattern": "run_r7_insample_chain\\.cmd",
      "done_regex": "^CHAIN DONE",
      "restart_safe": false,
      "max_restarts": 0,
      "stall_minutes": 600
    },
    {
      "name": "r7_holdout_chain",
      "wrapper": "run_r7_holdout_chain.cmd",
      "log": "r7_holdout_chain.log",
      "process_pattern": "run_r7_holdout_chai[n]",
      "done_regex": "^CHAIN DONE",
      "restart_safe": false,
      "max_restarts": 0,
      "stall_minutes": 600
    }
  ]
}
