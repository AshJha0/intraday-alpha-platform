    {
      "id": 117,
      "type": "timeseries",
      "title": "Live vs backtest drift (PSI)",
      "description": "LIVE from java (com.iap.adaptive.DriftMonitor): Population Stability Index of the rolling live signal window vs the research baseline (research/baselines/*.json, API_ADAPTIVE.md), labeled {alpha=...}. Industry rule of thumb: < 0.1 stable, 0.1-0.25 moderate, > 0.25 significant shift - the LiveVsBacktestDrift warning threshold (deployment/prometheus/alerts.yml).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "alpha_live_vs_backtest_drift",
          "legendFormat": "PSI {{alpha}}",
          "refId": "A"
        }
      ]
    },
