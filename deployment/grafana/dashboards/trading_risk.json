 "panels": [
  {
   "id": 101,
   "type": "stat",
   "title": "Kill switch",
   "description": "Latched by rust/risk on loss-limit breach (fail-closed). risk_kill_switch_engaged is LIVE from both the rust engine and the java platform.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "ARMED / TRADING",
         "color": "green"
        },
        "1": {
         "text": "ENGAGED \u2014 HALTED",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(risk_kill_switch_engaged) or vector(0)",
     "legendFormat": "engaged",
     "refId": "A"
    }
   ]
  },
