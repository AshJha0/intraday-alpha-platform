{
  "uid": "iap-trading-risk",
  "title": "Trading & Risk",
  "description": "Alpha health, execution quality and hard-risk state (spec \u00a725). Metric mapping: deployment/grafana/README.md. RETIRED with the Java image (v1.17 F9): the execution-slippage histogram, the live-vs-backtest PSI and the alpha lifecycle gauge panels were removed (no Python producer; exposed as <name>_available 0).",
  "tags": [
    "iap",
    "trading",
    "risk"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "Kill switch",
      "description": "Latched by rust/risk on loss-limit breach (fail-closed). risk_kill_switch_engaged is LIVE from the platform-metrics exporter (the MVP run's risk engine state).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ARMED / TRADING",
                  "color": "green"
                },
                "1": {
                  "text": "ENGAGED \u2014 HALTED",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(risk_kill_switch_engaged) or vector(0)",
          "legendFormat": "engaged",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Daily P&L (realized + unrealized)",
      "description": "risk_daily_pnl \u2014 the risk engine's daily P&L in the reporting currency (USD), the same unit as global.max_daily_loss (PLATFORM_CONVENTIONS.md \u00a712.1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(risk_daily_pnl)",
          "legendFormat": "PnL",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Daily loss-limit utilization",
      "description": "Daily loss against the LIVE limit gauge risk_limit{limit=\"max_daily_loss\"} \u2014 never a hand-copied constant, so a GOVERNANCE \u00a73 limit change moves this stat and the LossLimitUtilizationHigh page together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(-sum(risk_daily_pnl), 0) / sum(risk_limit{limit=\"max_daily_loss\"})",
          "legendFormat": "of max_daily_loss",
          "refId": "A"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Fill rate (5m)",
      "description": "exec_fills_total / exec_orders_submitted_total over 5m \u2014 the platform's OWN execution counters (\u00a712.6).",
