{
 "uid": "iap-trading-risk",
 "title": "Trading & Risk",
 "description": "Alpha health, execution quality and hard-risk state (spec \u00a725). Metric mapping: deployment/grafana/README.md.",
 "tags": [
  "iap",
  "trading",
  "risk"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
