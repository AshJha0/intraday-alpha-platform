      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(job:exec_fill_rate:ratio5m)",
          "legendFormat": "fills/accepted",
          "refId": "A"
        }
      ]
    },
