    {
      "id": 15,
      "type": "timeseries",
      "title": "Book stale & session restarts",
      "description": "book_stale{instrument} is 1 while any venue book of the instrument is stale (fail-closed trading); risk_session_restarts_total counts --resume restarts, each of which re-warms the book from the stream (PLATFORM_CONVENTIONS.md §12.3).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "book_stale",
          "legendFormat": "stale instrument {{instrument}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "risk_session_restarts_total",
          "legendFormat": "restarts {{service}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "JVM GC pause p99",
      "description": "GcPauseHigh alert at 10ms sustained 5m (spec §23).",
