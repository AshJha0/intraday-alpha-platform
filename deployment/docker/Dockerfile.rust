# =============================================================================
# Dockerfile.rust — IAP Rust replay / telemetry image
#
# Two-stage build (docs/BUILD_NOTES.md):
#   stage 1: cargo build --release of the workspace (deps pinned to
#            serde/serde_json per PLATFORM_CONVENTIONS.md §10; Cargo.lock is
#            the pin — commit it and never build a release image without it)
#   stage 2: slim runtime carrying the `demo` replay binary (deterministic
#            golden-vector replay: per-venue books, QC counters, throughput).
#
# Build (from the REPO ROOT):
#   docker build -f deployment/docker/Dockerfile.rust -t iap/rust:1.0.0 .
#
# Telemetry: rust/telemetry renders Prometheus text exposition
# (Registry::to_prometheus), but NO binary in this image writes it — the
# `demo` replay binary does not touch telemetry. The compose exporter sidecar
# and the Prometheus file-SD target that pretended otherwise were removed in
# round 3 (see deployment/prometheus/prometheus.yml). Re-introduce them
# together with a producer, never before.
# Digest pinning policy: see Dockerfile.python header / SECURITY.md (base images are
# pinned by digest below; Dependabot's docker ecosystem proposes bumps).
# =============================================================================

# ---------------------------------------------------------------- build stage
FROM rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS build
# Toolchain pinned to rust/rust-toolchain.toml (1.98.1); check_deployment.py
# fails if the two drift. Workspace rust-version (MSRV) = 1.75.

# configs/, data/reference/ and research/alpha_registry.json are NOT optional:
# the workspace's golden and rule tests resolve
# ../../configs/{risk/risk.json,strategies/{alpha_params,lifecycle,strategies}.json},
# ../../data/reference/feature_registry.json and
# ../../research/alpha_registry.json relative to CARGO_MANIFEST_DIR
# (rust/risk/tests/rules.rs, rust/alpha/tests/golden_alpha.rs,
# rust/features/tests/golden_features.rs, rust/lifecycle/tests/golden_lifecycle.rs
# — the registry byte-parity check). Without them `RUN cargo test` fails.
# .dockerignore keeps rust/target (668 MB of host-path build state) out.
WORKDIR /build
COPY rust rust
COPY tests/golden tests/golden
COPY configs configs
COPY data/reference data/reference
COPY research/alpha_registry.json research/alpha_registry.json

# -j2: 2-CPU baseline environment (BUILD_NOTES.md).
RUN cd rust && cargo build --release --locked -j2 --workspace

# Tests at image-build time: never publish an image from a tree failing the
# golden/parity suite (GOVERNANCE.md promotion gate 10). The workspace run
# includes the contracts (golden_canonical_json, golden_trace) and lifecycle
# (golden_lifecycle) golden targets registered in tests/harness/run_all.sh.
RUN cd rust && cargo test --release --locked -j2 --workspace

# -------------------------------------------------------------- runtime stage
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

RUN groupadd --gid 10001 iap && \
    useradd --uid 10001 --gid iap --create-home --shell /usr/sbin/nologin iap

COPY --from=build /build/rust/target/release/demo /usr/local/bin/iap-rust-replay
COPY --from=build /build/tests/golden /golden

USER iap
WORKDIR /home/iap

# No HEALTHCHECK, deliberately. This is a finite batch replay that exits when
# the pass is done, and the binary has no cheap self-test mode: its only
# argument is the golden-vector directory, so `--version`/`--help` would be
# read as a path and fail instead of probing.
# The previous `test -x <binary>` could never fail, so it reported health it
# did not measure. Liveness for a batch job is its exit code (compose
# service_completed_successfully, k8s Job status).

# Argument = golden-vector directory (defaults compiled for the repo layout,
# so pass /golden explicitly in containers).
ENTRYPOINT ["/usr/local/bin/iap-rust-replay"]
CMD ["/golden"]
